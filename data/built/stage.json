{
 "_source": "Stage gauges of the binding battery. Swap shift = mean[p(gold|orig) - p(gold|swap)] over the candidates; > +.02 binds, < -.02 inverts. dyn = dynamic 'you' (ownership changes hands in the scene); 0-shot and 3-shot.",
 "stages": [
  {
   "n": 1,
   "name": "I binds",
   "gloss": "\"I\" resolves to whoever is speaking.",
   "ex": "Jack: I'm holding the ___",
   "ok": "every base ≥ 0.5B",
   "olmo1b": "~21–63B tokens",
   "ours": "~3–3.75B tokens"
  },
  {
   "n": 2,
   "name": "you = me",
   "gloss": "\"you\" is read as the speaker too: the pronoun-reversal phase young children go through.",
   "ex": "Jack: you're holding the ___  → Jack's object",
   "ok": "transient in every trajectory",
   "olmo1b": "~63B → ~500B tokens",
   "ours": "transient, ~4–20B"
  },
  {
   "n": 3,
   "name": "static you binds",
   "gloss": "\"you\" resolves to the addressee, when ownership is simply stated.",
   "ex": "Carol has the onion. … Jack: you're holding the ___",
   "ok": "every base ≥ 0.6B trained on trillions of tokens, except Bamba 9B",
   "olmo1b": "420–525B tokens",
   "ours": "by 33B tokens annealed (trunk: 40B); +.192 at 110B"
  },
  {
   "n": 4,
   "name": "you = me, again",
   "gloss": "once objects change hands in the scene, \"you\" collapses back onto the speaker.",
   "ex": "Erin gives Paul her cup. … Paul: now you're holding the ___",
   "ok": "where every base up to 4B stops",
   "olmo1b": "from ~63B, still there at 4T",
   "ours": "from ~4B; at 110B no longer inverted under the gauge rule (−.027 at 11B → −.014)"
  },
  {
   "n": 5,
   "name": "dynamic you binds",
   "gloss": "\"you\" tracked through transfers. In-context first (3-shot), zero-shot last.",
   "ex": "same scene, answered correctly without examples",
   "ok": "zero-shot: from about 7B (OLMo-2 7B, Qwen2.5 7B), and every base from 13B up; with three worked examples: from Qwen3 4B",
   "olmo1b": "never (flat to 4T)",
   "ours": "zero-shot: not reached by 110B; with three worked examples it binds at 110B (+.038), the smallest base measured that does under the +.02 rule"
  }
 ],
