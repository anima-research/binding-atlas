# virtualenvs and caches
.venv/
__pycache__/
*.pyc
# local-only: the path map to raw grids, and the grids root assembled from it
config/local-grids.tsv
.grids/
# build scratch: verification builds, ledgers, card renders, derived templates
out/
config/local-names.tsv
# host-supplied web font files (not redistributed; see site/fonts/README)
site/fonts/*.woff2
# the connections panel shards (~47 MB, regenerated from the corpus graph; data/built/neurons/conn/conn.json holds their sha256)
data/built/neurons/conn/*.bin
site/threads-data/conn/*.bin
# /take: the item pool (fresh draws stay off the public repo), invites, the database, local venvs
take/data/
take/.venv*/
*.sqlite
invites.txt
